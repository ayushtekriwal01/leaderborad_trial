{
  "name": "MCC Creator Leaderboard — Hourly Refresh",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-1",
      "name": "Every 1 hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.METABASE_URL }}/api/card/{{ $env.METABASE_CARD_ID }}/query/json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "={{ $env.METABASE_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "metabase-1",
      "name": "Metabase: fetch creator data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        230,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LEADERBOARD_APP_URL }}/api/publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.LEADERBOARD_PUBLISH_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ rows: $input.all().map(i => i.json) }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "executeOnce": true,
      "id": "publish-1",
      "name": "Publish to leaderboard app",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.published }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-1",
      "name": "Published OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        690,
        0
      ]
    },
    {
      "parameters": {
        "errorMessage": "=Leaderboard publish rejected: {{ JSON.stringify($json.errors || $json.error) }}"
      },
      "id": "stop-1",
      "name": "Fail run (keeps previous dataset live)",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        920,
        140
      ]
    }
  ],
  "connections": {
    "Every 1 hour": {
      "main": [
        [
          {
            "node": "Metabase: fetch creator data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Metabase: fetch creator data": {
      "main": [
        [
          {
            "node": "Publish to leaderboard app",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to leaderboard app": {
      "main": [
        [
          {
            "node": "Published OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Published OK?": {
      "main": [
        [],
        [
          {
            "node": "Fail run (keeps previous dataset live)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
